# Variabili d'ambiente — REGOLO STP
# Copiare in `.env.local` (ignorato da git) e riempire.
# Su Vercel le stesse vanno in Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Il brief (fase 2)
# ---------------------------------------------------------------------------

# Chiave API di Resend. Senza questa, IN SVILUPPO le due mail non partono: si
# scrivono in `.brief-dev/` (.txt e .html) e si stampano in console — è così che
# si prova il form end-to-end senza spedire niente a nessuno.
# IN PRODUZIONE se manca il brief NON si dà per inviato: si risponde
# «non inviato» e si logga l'errore. Non si perde un lead in silenzio.
RESEND_API_KEY=

# Mittente delle due mail. Il dominio deve essere verificato su Resend, quindi
# dipende dalla decisione n. 2 (dominio definitivo) — vedi DECISIONI.md.
# Forma: "REGOLO <brief@dominio.it>"
BRIEF_FROM=

# Dove arriva il brief. In produzione è la casella dello studio, che è un dato
# bloccante: [[DA CLIENTE: casella dove arrivano i brief]] in
# CONTENUTI-DA-CLIENTE.md. In sviluppo si mette un proprio indirizzo di test.
BRIEF_TO=

# ---------------------------------------------------------------------------
# Sito
# ---------------------------------------------------------------------------

# Origine pubblica del sito, per `metadataBase`, Open Graph e canonical.
# Finché la decisione n. 2 è aperta resta vuota: meglio nessun canonical che
# un canonical sbagliato.
NEXT_PUBLIC_SITE_URL=
