# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Blu Lang
*.pdf
!.env.example

# mail del brief scritte dal trasporto di sviluppo (nessuna RESEND_API_KEY)
.brief-dev/

# artefatti del MCP Playwright (screenshot e snapshot dei test)
.playwright-mcp/

# esiti degli script di collaudo: si rigenerano lanciando gli script.
# CONFRONTO.png e firme.json restano, perché sono la prova che si guarda in call.
collaudo/*
!collaudo/opzioni/
collaudo/opzioni/*
!collaudo/opzioni/CONFRONTO.png
!collaudo/opzioni/firme.json
